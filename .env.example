# RentHub environment configuration
# Copy this file to .env and fill in real values after creating your Supabase project.

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Settings → API → anon public). This is safe to expose.
VITE_SUPABASE_ANON_KEY=

# Public app URL uses for links/emails (optional)
VITE_APP_URL=http://localhost:5173

# NEVER put your service_role key in a VITE_* variable. It would be shipped
# to the browser and give anyone full database access.